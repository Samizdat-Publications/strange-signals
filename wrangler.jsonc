{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strange-signals",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  // The whole repo is the static site — there is no build step. Routing is
  // asset-first: any path matching a file on disk is served directly, and only
  // paths with no matching file (i.e. /api/signal) reach worker.js.
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "main": "worker.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Daily-counter store for the shared SIGNAL Analyst. Bindings have to be
  // declared HERE rather than added in the dashboard: deploys run
  // `wrangler deploy`, which treats this file as the source of truth and can
  // drop bindings that exist only in the dashboard.
  //
  // This is half of the analyst's two-part opt-in. The other half is the
  // secret, which never appears in this file and is set out of band with:
  //   npx wrangler secret put ANTHROPIC_API_KEY
  // Until that secret exists, /api/signal returns 503 and costs nothing.
  "kv_namespaces": [
    { "binding": "SIGNAL_QUOTA", "id": "06bebf3f23284a72998a567f9ad9a461" }
  ]
}
