.DS_Store
__pycache__/
*.pyc

# Environment / secrets (API keys — NEVER commit)
.env
.env.local

# Raw downloads and intermediate files (regenerated by setup_sightings.sh)
data/raw/
data/*.xlsx

# Descriptions file (lazy-loaded, not yet implemented)
data/sightings_descriptions.json

# Pipeline writes per-category gzipped map data — keep those committed (along with overlay JSONs).
# Block uncompressed companions if someone runs `gunzip -k` locally; the app only ever fetches .gz.
data/sightings_*.json
# ...but the shard manifest IS a real committed asset the browser fetches at startup.
!data/sightings_manifest.json

# HuggingFace NUFORC geocoding intermediates. Regenerated by geocode_nuforc_hf.py;
# the only output that matters downstream is folded into the workbook.
data/nuforc_hf_*.csv
data/geocode_cache/
# Keep committed: sightings_{ufo,bigfoot,haunted}.json.gz, us_population_density.json, military_bases.json, national_parks.json, historic_sites.json

# Claude Code worktrees (ephemeral)
.claude/worktrees/

# Screenshots / large images (except committed screenshots)
*.png
*.jpg
*.jpeg
!screenshots/*.png
!screenshots/*.jpg

# Wrangler / Cloudflare local state
.wrangler/

# Playwright MCP scratch output (snapshots, console logs)
.playwright-mcp/

# Node (shouldn't exist but just in case)
node_modules/

# Claude Code local settings
.claude/settings.local.json
