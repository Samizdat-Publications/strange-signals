.DS_Store
__pycache__/
*.pyc

# Environment / secrets (API keys — NEVER commit)
.env
.env.local

# Raw downloads and intermediate files (regenerated by setup_sightings.sh)
data/raw/
data/*.xlsx

# Descriptions file (lazy-loaded, not yet implemented)
data/sightings_descriptions.json

# Pipeline writes the gzipped map data — keep that committed (along with overlay JSONs).
# Block the uncompressed companion if someone runs `gunzip -k` locally; the app only ever
# fetches the .gz.
data/sightings_map_data.json
# Keep committed: sightings_map_data.json.gz, us_population_density.json, military_bases.json, national_parks.json, historic_sites.json

# Claude Code worktrees (ephemeral)
.claude/worktrees/

# Screenshots / large images (except committed screenshots)
*.png
*.jpg
*.jpeg
!screenshots/*.png
!screenshots/*.jpg

# Node (shouldn't exist but just in case)
node_modules/

# Claude Code local settings
.claude/settings.local.json
